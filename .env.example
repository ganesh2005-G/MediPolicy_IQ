# MediPolicy_IQ Configuration Template

# 1. Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=medipolicy_iq_super_secret_jwt_key_2026_enterprise_healthcare_platform

# 2. Storage & Caching
# Default fallback to SQLite: sqlite:///./medipolicy_iq.db
# For production PostgreSQL: postgresql://postgres:postgres@localhost:5432/medipolicy_iq
DATABASE_URL=sqlite:///./medipolicy_iq.db
REDIS_URL=redis://localhost:6379/0

# 3. AI Service Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
EMBEDDING_API_KEY=your_openai_api_key_here
VECTOR_DATABASE_URL=http://localhost:6333

# 4. Notifications & SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@medipolicy.iq
SMTP_PASSWORD=smtp_password_here
